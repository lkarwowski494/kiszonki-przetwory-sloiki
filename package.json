{
  "name": "kiszonki-przetwory-sloiki",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "private": true,
  "description": "Słoik (Jarwise) — Apps4Brew: asystent domowego przetwórstwa, fermentacji, pasteryzacji, spiżarnia i 24 receptury świata",
  "scripts": {
    "start": "expo start",
    "build": "tsc --outDir dist",
    "test": "npm run build && jest",
    "test:fast": "jest --onlyChanged",
    "test:domain": "npm run build && jest dist/__tests__",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm test"
  },
  "dependencies": {
    "expo": "~57.0.26",
    "expo-asset": "~57.0.18",
    "expo-av": "^16.0.8",
    "expo-clipboard": "^58.0.3",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-haptics": "~57.0.3",
    "expo-keep-awake": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.24",
    "expo-sharing": "~57.0.22",
    "expo-sqlite": "~57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.10",
    "fast-check": "^4.10.2",
    "jest": "^29.7.0",
    "typescript": "^5.5.4"
  }
}
