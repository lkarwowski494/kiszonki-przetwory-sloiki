{
  "name": "kiszonki-przetwory-sloiki",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "description": "Słoik (Jarwise) — Apps4Brew: asystent domowego przetwórstwa, fermentacji, pasteryzacji, spiżarnia i 24 receptury świata",
  "scripts": {
    "start": "expo start",
    "build": "tsc --outDir dist",
    "test": "npm run build && jest",
    "test:fast": "jest --onlyChanged",
    "test:domain": "npm run build && jest dist/__tests__",
    "typecheck": "tsc --noEmit",
    "check:matrix": "node scripts/test-matrix.mjs --check",
    "matrix:write": "node scripts/test-matrix.mjs --write",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:maestro": "node scripts/check-maestro.mjs",
    "check:licenses": "node scripts/licenses.mjs",
    "check:corpus": "node scripts/check-corpus.mjs",
    "verify:native": "node scripts/verify-native.mjs",
    "generate:assets": "node scripts/generate-assets.mjs",
    "verify": "npm run typecheck && npm test && npm run check:corpus && npm run check:i18n && npm run check:matrix && npm run check:maestro && npm run check:licenses && npm run verify:native"
  },
  "dependencies": {
    "@apps4craft/ui": "github:lkarwowski494/apps4craft-ui",
    "expo": "~57.0.26",
    "expo-asset": "~57.0.18",
    "expo-audio": "~57.0.5",
    "expo-camera": "^57.0.6",
    "expo-clipboard": "^58.0.3",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-haptics": "~57.0.3",
    "expo-keep-awake": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-notifications": "^57.0.21",
    "expo-print": "^57.0.2",
    "expo-router": "~57.0.24",
    "expo-sharing": "~57.0.22",
    "expo-sqlite": "~57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.10",
    "@types/react-test-renderer": "^19.3.0",
    "fast-check": "^4.10.2",
    "jest": "^29.7.0",
    "react-test-renderer": "^19.2.3",
    "typescript": "^5.5.4"
  }
}
