{
  "expo": {
    "name": "Słoik",
    "slug": "sloik",
    "version": "1.0.0",
    "scheme": "sloik",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "description": "Słoik (Jarwise) — asystent domowego przetwórstwa, fermentacji, pasteryzacji, spiżarnia i 24 receptury świata. 100% Offline-First.",
    "primaryColor": "#2E5A27",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F5F0"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.apps4brew.sloik",
      "appleTeamId": "8NQ9GHY8GF",
      "buildNumber": "1",
      "infoPlist": {
        "UIBackgroundModes": ["audio"],
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true,
        "CFBundleAllowMixedLocalizations": true,
        "NSCameraUsageDescription": "Aparat jest używany do szybkiego skanowania kodów QR na etykietach słoików w Twojej spiżarni.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.apps4brew.sloik",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F7F5F0"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Aparat jest używany do szybkiego skanowania kodów QR na etykietach słoików w Twojej spiżarni."
        }
      ],
      [
        "expo-sqlite",
        {
          "enableFTS": true
        }
      ]
    ]
  }
}
